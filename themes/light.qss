/* ============================================================
   Pocket Rogues RU-Wiki -- Тёмная тема QSS (по умолчанию)
   Палитра:
     Фон окна/приложения:  #f0f0f0
     Фон панелей/виджетов: #e0e0e0
     Фон полей ввода:      #ffffff
     Границы:              #cccccc
     Текст основной:       #222222
     Текст заголовков:     #000000
     Текст приглушённый:   #666666
     Accent:               #007a9e
     Accent hover:         #007a9e
     Disabled:             #666666
   ============================================================ */

/* ============================================================
   1. БАЗОВЫЕ ЭЛЕМЕНТЫ
   ============================================================ */

/* Главное окно и все дочерние QWidget по умолчанию */
QWidget {
    background-color: #f0f0f0;
    color: #222222;
    font-family: sans-serif;
    font-size: 13px;
}

/* ============================================================
   2. ЛЕВАЯ ПАНЕЛЬ (Main.py)
   ============================================================ */

/* Контейнер левой панели -- светлее фона окна */
#leftPanel {
    background-color: transparent;
    border-right: none;
    border-radius: 4px;
}

/* Заголовок "- Вкладки -" над списком */
#leftPanelTitle {
    color: #007a9e;
    font-size: 12px;
    font-weight: bold;
    padding: 8px 0;
    border-bottom: 1px solid #007a9e;
    margin-bottom: 4px;
}

/* Список вкладок */
#mainTabsList {
    background-color: #d8d8d8;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    outline: none;
    padding: 6px;
    font-size: 13px;
}

/* Отдельный пункт в списке */
#mainTabsList::item {
    background-color: #e8e8e8;
    padding: 8px 12px;
    border-radius: 4px;
    margin-bottom: 4px;
    color: #222222;
}

/* Пункт при наведении */
#mainTabsList::item:hover {
    background-color: #d0d0d0;
}

/* Активный (выбранный) пункт -- accent-подсветка */
#mainTabsList::item:selected {
    background-color: #c8c8c8;
    color: #000000;
    border-left: 3px solid #007a9e;
}

/* ============================================================
   3. ВЕРХНЕЕ МЕНЮ (WikiMenu)
   ============================================================ */

#mainMenuBar {
    background-color: #e0e0e0;
    border: 1px solid #cccccc;
    border-radius: 6px;
    padding: 3px;
    font-size: 14px;
}

/* Пункты меню */
#mainMenuBar::item {
    background: transparent;
    padding: 5px 10px;
    margin-right: 10px;
    border-radius: 3px;
    color: #222222;
}

#mainMenuBar::item:selected {
    background-color: #c8c8c8;
    color: #007a9e;
}

#mainMenuBar::item:pressed {
    background-color: #cccccc;
}

/* Выпадающие подменю */
QMenu {
    background-color: #e8e8e8;
    border: 1px solid #cccccc;
    padding: 4px;
}

QMenu::item {
    padding: 6px 20px;
    border-radius: 3px;
    color: #222222;
}

QMenu::item:selected {
    background-color: #c8c8c8;
    color: #007a9e;
}

/* Отключённый (недоступный) пункт меню */
QMenu::item:disabled {
    color: #666666;
}

/* Разделители внутри подменю */
QMenu::separator {
    height: 1px;
    background: #cccccc;
    margin: 4px 8px;
}

/* ============================================================
   4. ШАПКА СТРАНИЦЫ (WikiPage)
   ============================================================ */

/* Контейнер шапки */
#wikiHeader {
    background-color: #f0f0f0;
}

/* Разделитель шапки */
#wikiHeaderSeparator {
    background-color: #007a9e;
    max-height: 1px;
    border: none;
}

/* Логотип Pocket Rogues -- без фона, просто картинка */
#pageLogo {
    background: transparent;
}

/* ============================================================
   4. БРАУЗЕР (WikiPage)
   ============================================================ */

#wikiBrowserFrame{
    border: 1px solid #cccccc;
    border-radius: 4px;
    background-color: #1a1a1a;
}

/* ============================================================
   5. ЗАГОЛОВОК И ОПИСАНИЕ СТРАНИЦЫ (BasePage)
   ============================================================ */

/* Заголовок страницы (например, "История просмотра") */
#pageTitle {
    font-size: 18px;
    font-weight: bold;
    color: #000000;
    padding: 5px 0;
    background: transparent;
}

/* Описание страницы (под заголовком) */
#pageDescription {
    color: #666666;
    font-size: 13px;
    background: transparent;
}

/* Разделитель страницы */
#pageSeparator {
    background-color: #007a9e;
    max-height: 1px;
    border: none;
}

/* ============================================================
   6. КНОПКИ
   ============================================================ */

/* Базовая кнопка (QPushButton везде) */
QPushButton {
    background-color: #d0d0d0;
    color: #222222;
    border: 1px solid #cccccc;
    border-radius: 3px;
    padding: 5px 12px;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #cccccc;
    border-color: #aaaaaa;
}

QPushButton:pressed {
    background-color: #e8e8e8;
}

QPushButton:disabled {
    color: #666666;
    background-color: #f0f0f0;
    border-color: #e0e0e0;
}

/* Кнопка "Настройки" на вкладке "Недавние" */
#settingsButton {
    background-color: #d0d0d0;
    color: #222222;
    border: 1px solid #cccccc;
    border-radius: 3px;
    padding: 5px 15px;
}

#settingsButton:hover {
    background-color: #cccccc;
    border-color: #007a9e;
    color: #000000;
}

/* Кнопки в диалоге настроек */
#settingsSaveBtn {
    background-color: #007a9e;
    color: #ffffff;
    border: none;
    padding: 5px 15px;
}

#settingsSaveBtn:hover {
    background-color: #00b7e0;
}

#settingsCancelBtn {
    background-color: #d0d0d0;
    color: #222222;
    border: 1px solid #cccccc;
    padding: 5px 15px;
}

#settingsCancelBtn:hover {
    background-color: #cccccc;
}

/* ============================================================
   7. ОБЛАСТЬ ПРОКРУТКИ
   ============================================================ */

#pageScrollArea {
    background-color: transparent;
    border: none;
}

/* Скрываем рамку у внутреннего QWidget области прокрутки */
#pageScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* Контейнер карточек -- без фона */
#cardsContainer {
    background-color: transparent;
}

/* ============================================================
   8. КАРТОЧКИ (PreviewCard)
   ============================================================ */

#previewCard {
    background-color: #e0e0e0;
    border: 2px solid #cccccc;
    border-radius: 4px;
}

#previewCard:hover {
    border-color: #007a9e;
    background-color: #d0d0d0;
}

/* Заголовок карточки */
#cardTitle {
    background: transparent;
    color: #000000;
    font-size: 14px;
    font-weight: bold;
    padding-bottom: 4px;
    border-bottom: 1px solid #007a9e;
    margin-bottom: 4px;
}

/* Превью-текст карточки */
#cardPreview {
    background: transparent;
    color: #666666;
    font-size: 11px;
}

/* Кнопка-звёздочка на карточке */
#cardRemoveBtn {
    background: transparent;
    border: none;
}

#cardRemoveBtn:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
}

/* Заглушка ("История пуста", "Список пуст") */
#emptyLabel {
    color: #666666;
    font-size: 14px;
    background: transparent;
}
#emptyContainer {
    background: transparent;
}
#emptyLogo {
    background: transparent;
}

/* ============================================================
   9. ЗАМЕТКИ (TipsPage)
   ============================================================ */

/* Поле для Markdown */
#notesEditor {
    background-color: #ffffff;
    color: #222222;
    border: 1px solid #cccccc;
    border-radius: 3px;
    padding: 8px;
    font-family: monospace;
    font-size: 13px;
    selection-background-color: #007a9e;
    selection-color: #ffffff;
}

#notesEditor:focus {
    border-color: #007a9e;
}

/* Поле просмотра */
#notesPreview {
    background-color: #ffffff;
    color: #222222;
    border: 1px solid #cccccc;
    border-radius: 3px;
    padding: 8px;
    selection-background-color: #007a9e;
    selection-color: #ffffff;
}

#notesPreview:focus {
    border-color: #007a9e;
}

/* ============================================================
   10. ДИАЛОГИ И ЭЛЕМЕНТЫ ФОРМ
   ============================================================ */

/* Диалоговое окно */
QDialog {
    background-color: #f0f0f0;
}

/* Чекбокс */
QCheckBox {
    color: #222222;
    spacing: 8px;
    background: transparent;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #aaaaaa;
    border-radius: 3px;
    background-color: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #007a9e;
}

QCheckBox::indicator:checked {
    background-color: #007a9e;
    border-color: #007a9e;
}

/* Спинбокс */
QSpinBox {
    background-color: #ffffff;
    color: #222222;
    border: 1px solid #cccccc;
    border-radius: 3px;
    padding: 4px 6px;
}

QSpinBox:focus {
    border-color: #007a9e;
}

/* Стрелки спинбокса */
QSpinBox::up-button,
QSpinBox::down-button {
    background-color: #d0d0d0;
    border: none;
    width: 16px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background-color: #cccccc;
}

QSpinBox::up-arrow {
    image: url(themes/arrow_up.png);
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow {
    image: url(themes/arrow_down.png);
    width: 10px;
    height: 10px;
}

/* ============================================================
   11. СКРОЛЛБАРЫ
   ============================================================ */

QScrollBar:vertical {
    background: #f0f0f0;
    width: 10px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background: #cccccc;
    border-radius: 5px;
    min-height: 30px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #aaaaaa;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: #f0f0f0;
    height: 10px;
    margin: 0;
    border: none;
}

QScrollBar::handle:horizontal {
    background: #cccccc;
    border-radius: 5px;
    min-width: 30px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: #aaaaaa;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ============================================================
   12. ТУЛТИПЫ
   ============================================================ */

QToolTip {
    background-color: #e0e0e0;
    color: #222222;
    border: 1px solid #aaaaaa;
    border-radius: 3px;
    padding: 4px 8px;
    font-size: 12px;
}