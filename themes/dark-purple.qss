/* ============================================================
   1. БАЗОВЫЕ ЭЛЕМЕНТЫ
   ============================================================ */

/* Главное окно и все дочерние QWidget по умолчанию */
QWidget {
    background-color: #2a2a2a;
    color: #d5d5d5;
    font-family: sans-serif;
    font-size: 13px;
}

/* Важное правило иконкам */
QMenu::right-arrow {
    image: url(themes/white_arrow_right.png);
    width: 18px;
    height: 18px;
}

/* ============================================================
   2. ЛЕВАЯ ПАНЕЛЬ (Main.py)
   ============================================================ */

/* Контейнер левой панели -- светлее фона окна */
#leftPanel {
    background-color: transparent;
    border-right: none;
    border-radius: 4px;
}

/* Заголовок "- Вкладки -" над списком */
#leftPanelTitle {
    color: #a855f7;
    font-size: 12px;
    font-weight: bold;
    padding: 8px 0;
    border-bottom: 1px solid #a855f7;
    margin-bottom: 4px;
}

/* Список вкладок */
#mainTabsList {
    background-color: #262626;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    outline: none;
    padding: 6px;
    font-size: 13px;
}

/* Отдельный пункт в списке */
#mainTabsList::item {
    background-color: #2f2f2f;
    padding: 8px 12px;
    border-radius: 4px;
    margin-bottom: 4px;
    color: #d5d5d5;
}

/* Пункт при наведении */
#mainTabsList::item:hover {
    background-color: #3a3a3a;
}

/* Активный (выбранный) пункт -- accent-подсветка */
#mainTabsList::item:selected {
    background-color: #3a3a3a;
    color: #ffffff;
    border-left: 3px solid #a855f7;
}

/* ============================================================
   3. ВЕРХНЕЕ МЕНЮ (WikiMenu)
   ============================================================ */

#mainMenuBar {
    background-color: #333333;
    border: 1px solid #444444;
    border-radius: 6px;
    padding: 3px;
    font-size: 14px;
}

/* Пункты меню */
#mainMenuBar::item {
    background: transparent;
    padding: 5px 10px;
    margin-right: 10px;
    border-radius: 3px;
    color: #d5d5d5;
}

#mainMenuBar::item:selected {
    background-color: #3a3a3a;
    color: #a855f7;
}

#mainMenuBar::item:pressed {
    background-color: #444444;
}

/* Выпадающие подменю */
QMenu {
    background-color: #2f2f2f;
    border: 1px solid #444444;
    padding: 4px;
}

QMenu::item {
    padding: 6px 20px;
    border-radius: 3px;
    color: #d5d5d5;
}

QMenu::item:selected {
    background-color: #3a3a3a;
    color: #a855f7;
}

/* Отключённый (недоступный) пункт меню */
QMenu::item:disabled {
    color: #666666;
}

/* Разделители внутри подменю */
QMenu::separator {
    height: 1px;
    background: #444444;
    margin: 4px 8px;
}

/* ============================================================
   4. ШАПКА СТРАНИЦЫ (WikiPage)
   ============================================================ */

/* Контейнер шапки */
#wikiHeader {
    background-color: #2a2a2a;
}

/* Логотип Pocket Rogues -- без фона, просто картинка */
#pageLogo {
    background: transparent;
}

/* ============================================================
   4. БРАУЗЕР (WikiPage)
   ============================================================ */

#wikiBrowserFrame{
    border: 1px solid #444444;
    border-radius: 4px;
    background-color: #1a1a1a;
}

/* ============================================================
   5. ЗАГОЛОВОК И ОПИСАНИЕ СТРАНИЦЫ (BasePage)
   ============================================================ */

/* Заголовок страницы (например, "История просмотра") */
#pageTitle {
    font-size: 18px;
    font-weight: bold;
    color: #ffffff;
    padding: 5px 0;
    background: transparent;
}

/* Описание страницы (под заголовком) */
#pageDescription {
    color: #888888;
    font-size: 13px;
    background: transparent;
}

/* Разделитель страницы */
#pageSeparator {
    background-color: #a855f7;
    max-height: 1px;
    border: none;
}

/* ============================================================
   6. КНОПКИ
   ============================================================ */

/* Базовая кнопка (QPushButton везде) */
QPushButton {
    background-color: #3a3a3a;
    color: #d5d5d5;
    border: 1px solid #444444;
    border-radius: 3px;
    padding: 5px 12px;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #444444;
    border-color: #555555;
}

QPushButton:pressed {
    background-color: #2f2f2f;
}

QPushButton:disabled {
    color: #666666;
    background-color: #2a2a2a;
    border-color: #333333;
}

/* Кнопка "Настройки" на вкладке "Недавние" */
#settingsButton {
    background-color: #3a3a3a;
    color: #d5d5d5;
    border: 1px solid #444444;
    border-radius: 3px;
    padding: 5px 15px;
}

#settingsButton:hover {
    background-color: #444444;
    border-color: #a855f7;
    color: #ffffff;
}

/* Кнопки в диалоге настроек */
#settingsSaveBtn {
    background-color: #a855f7;
    color: #ffffff;
    border: none;
    padding: 5px 15px;
}

#settingsSaveBtn:hover {
    background-color: #c084fc;
}

#settingsCancelBtn {
    background-color: #3a3a3a;
    color: #d5d5d5;
    border: 1px solid #444444;
    padding: 5px 15px;
}

#settingsCancelBtn:hover {
    background-color: #444444;
}

/* ============================================================
   7. ОБЛАСТЬ ПРОКРУТКИ
   ============================================================ */

#pageScrollArea {
    background-color: transparent;
    border: none;
}

/* Скрываем рамку у внутреннего QWidget области прокрутки */
#pageScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* Контейнер карточек -- без фона */
#cardsContainer {
    background-color: transparent;
}

/* ============================================================
   8. КАРТОЧКИ (PreviewCard)
   ============================================================ */

#previewCard {
    background-color: #333333;
    border: 2px solid #444444;
    border-radius: 4px;
}

#previewCard:hover {
    border-color: #a855f7;
    background-color: #3a3a3a;
}

/* Заголовок карточки */
#cardTitle {
    background: transparent;
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
    padding-bottom: 4px;
    border-bottom: 1px solid #a855f7;
    margin-bottom: 4px;
}

/* Превью-текст карточки */
#cardPreview {
    background: transparent;
    color: #888888;
    font-size: 11px;
}

/* Кнопка-звёздочка на карточке */
#cardRemoveBtn {
    background: transparent;
    border: none;
}

#cardRemoveBtn:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
}

/* Заглушка ("История пуста", "Список пуст") */
#emptyLabel {
    color: #666666;
    font-size: 14px;
    background: transparent;
}
#emptyContainer {
    background: transparent;
}
#emptyLogo {
    background: transparent;
}

/* ============================================================
   9. ЗАМЕТКИ (TipsPage)
   ============================================================ */

/* Поле для Markdown */
#notesEditor {
    background-color: #1f1f1f;
    color: #d5d5d5;
    border: 1px solid #444444;
    border-radius: 3px;
    padding: 8px;
    font-family: monospace;
    font-size: 13px;
    selection-background-color: #a855f7;
    selection-color: #ffffff;
}

#notesEditor:focus {
    border-color: #a855f7;
}

/* Поле просмотра */
#notesPreview {
    background-color: #1f1f1f;
    color: #d5d5d5;
    border: 1px solid #444444;
    border-radius: 3px;
    padding: 8px;
    selection-background-color: #a855f7;
    selection-color: #ffffff;
}

#notesPreview:focus {
    border-color: #a855f7;
}

/* ============================================================
   10. ДИАЛОГИ И ЭЛЕМЕНТЫ ФОРМ
   ============================================================ */

/* Диалоговое окно */
QDialog {
    background-color: #2a2a2a;
}

/* Чекбокс */
QCheckBox {
    color: #d5d5d5;
    spacing: 8px;
    background: transparent;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #555555;
    border-radius: 3px;
    background-color: #1f1f1f;
}

QCheckBox::indicator:hover {
    border-color: #a855f7;
}

QCheckBox::indicator:checked {
    background-color: #a855f7;
    border-color: #a855f7;
}

/* Спинбокс */
QSpinBox {
    background-color: #1f1f1f;
    color: #d5d5d5;
    border: 1px solid #444444;
    border-radius: 3px;
    padding: 4px 6px;
}

QSpinBox:focus {
    border-color: #a855f7;
}

/* Стрелки спинбокса */
QSpinBox::up-button,
QSpinBox::down-button {
    background-color: #3a3a3a;
    border: none;
    width: 16px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background-color: #444444;
}

QSpinBox::up-arrow {
    image: url(themes/arrow_up.png);
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow {
    image: url(themes/arrow_down.png);
    width: 10px;
    height: 10px;
}

/* ============================================================
   11. СКРОЛЛБАРЫ
   ============================================================ */

QScrollBar:vertical {
    background: #2a2a2a;
    width: 10px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background: #444444;
    border-radius: 5px;
    min-height: 30px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #555555;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: #2a2a2a;
    height: 10px;
    margin: 0;
    border: none;
}

QScrollBar::handle:horizontal {
    background: #444444;
    border-radius: 5px;
    min-width: 30px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: #555555;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ============================================================
   12. ТУЛТИПЫ
   ============================================================ */

QToolTip {
    background-color: #333333;
    color: #d5d5d5;
    border: 1px solid #555555;
    border-radius: 3px;
    padding: 4px 8px;
    font-size: 12px;
}

/* ============================================================
   13. РЕДАКТОР
   ============================================================ */

#editorPagesList {
    background-color: #262626;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    padding: 6px;
    outline: none;
    font-size: 13px;
}

#editorPagesList::item {
    background-color: #2f2f2f;
    padding: 8px 12px;
    border-radius: 4px;
    margin-bottom: 4px;
    color: #d5d5d5;
}

#editorPagesList::item:hover {
    background-color: #3a3a3a;
}

#editorPagesList::item:selected {
    background-color: #3a3a3a;
    color: #ffffff;
    border-left: 3px solid #a855f7;
}



#editorTabs::pane {
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    background-color: #2a2a2a;
    top: -1px;
}

#editorTabs QTabBar::tab {
    background-color: #2f2f2f;
    color: #d5d5d5;
    padding: 8px 20px;
    border: 1px solid #3a3a3a;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

#editorTabs QTabBar::tab:selected {
    background-color: #3a3a3a;
    color: #ffffff;
    border-bottom: 2px solid #a855f7;
}

#editorTabs QTabBar::tab:hover:selected {
    background-color: #333333;
}



#htmlEditor,
#cssEditor {
    background-color: #1f1f1f;
    color: #d4d4d4;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    padding: 8px;
    font-family: "Consolas", "Menlo", "Monaco", monospace;
    font-size: 13px;
    selection-background-color: #4a3a5c;
    selection-color: #ffffff;
}

#htmlEditor:focus,
#cssEditor:focus {
    border-color: #a855f7;
}



/* Кнопка "Сохранить" -- QToolButton с меню, серая */
#editorSaveBtn {
    background-color: #3a3a3a;
    color: #d5d5d5;
    border: 1px solid #444444;
    border-radius: 3px;
    padding: 5px 12px;
    font-size: 13px;
    min-width: 100px;
}

#editorSaveBtn:hover {
    background-color: #444444;
    border-color: #555555;
}

#editorSaveBtn:pressed {
    background-color: #2f2f2f;
}

#editorSaveBtn::menu-button {
    border-left: 1px solid #444444;
    width: 20px;
}

#editorSaveBtn::menu-button:hover {
    background-color: #444444;
}

#editorSaveBtn::menu-arrow {
    image: url(themes/arrow_down.png);
    width: 64px;
}

/* Кнопка "Открыть в Вики" -- QPushButton, accent */
#editorOpenWikiBtn {
    background-color: #a855f7;
    color: #ffffff;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 6px 12px;
    font-size: 13px;
}

#editorOpenWikiBtn:hover {
    background-color: #c084fc;
}

#editorOpenWikiBtn:pressed {
    background-color: #8a4fc7;
}

#editorOpenWikiBtn:disabled {
    background-color: #2f2f2f;
    color: #666666;
    border-color: transparent;
}



#reset_layout_btn {
    background-color: #3a3a3a;
    color: #d5d5d5;
    border: 1px solid #444444;
    border-radius: 3px;
    padding: 4px 10px;
    font-size: 12px;
}

#reset_layout_btn:hover {
    background-color: #444444;
    border-color: #a855f7;
}